{
  "name": "backend",
  "version": "1.1.10",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --coverage",
    "dev": "nodemon app.js",
    "start": "node app.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@graphql-tools/merge": "^9.2.6",
    "@graphql-tools/schema": "^10.1.3",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^8.7.1",
    "graphql": "^15.10.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "nodemon": "^3.1.14"
  },
  "keywords": [],
  "description": "",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "pnpm": {
    "overrides": {
      "glob": "^11.1.0",
      "path-to-regexp@8.3.0": "8.4.0",
      "brace-expansion@1.1.14": "1.1.21",
      "brace-expansion@5.0.5": "5.0.12",
      "brace-expansion@5.0.6": "5.0.12",
      "js-yaml@3.14.2": "3.15.2",
      "form-data@4.0.5": "4.0.6",
      "qs@6.14.2": "6.16.0",
      "@babel/core@7.29.0": "7.29.6"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  }
}
